{
  "name": "dshline-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "^22.19 || >=24"
  },
  "scripts": {
    "audit": "pnpm audit --audit-level moderate",
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "harness-target": "node tools/harness-target.mjs",
    "link-harness": "node tools/link-harness.mjs",
    "lint:workflows": "node tools/lint-workflows.mjs",
    "security": "pnpm run audit && pnpm run lint:workflows",
    "test": "vitest run",
    "test:codex": "node tools/test-codex.mjs",
    "test:consumer": "node tools/consumer-smoke.mjs",
    "typecheck": "tsc -b",
    "verify-docs": "node tools/verify-translation-pairing.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.3-alpha.1",
    "@deepseek-ai/dsh-authorization": "0.1.3-alpha.1",
    "@deepseek-ai/dsh-credentials": "0.1.3-alpha.1",
    "@deepseek-ai/dsh-invariants": "0.1.3-alpha.1",
    "@deepseek-ai/dsh-llm": "0.1.3-alpha.1",
    "@deepseek-ai/dsh-scope": "0.1.3-alpha.1",
    "@deepseek-ai/dsh-session": "0.1.3-alpha.1",
    "@deepseek-ai/dsh-settings": "0.1.3-alpha.1",
    "@deepseek-ai/dsh-subagent": "0.1.3-alpha.1",
    "@deepseek-ai/dsh-subagent-codex": "0.1.3-alpha.1",
    "@deepseek-ai/dsh-subprocess": "0.1.3-alpha.1",
    "@deepseek-ai/dsh-subprocess-local": "0.1.3-alpha.1",
    "@deepseek-ai/dsh-timeout": "0.1.3-alpha.1",
    "@types/node": "^26.4.0",
    "@xterm/headless": "^6.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
