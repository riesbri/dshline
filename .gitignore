node_modules/
lib/
dist/
*.tsbuildinfo
.pnpm-store/

# `pnpm pack` output. The packed-consumer check (tools/consumer-smoke.mjs, and
# the manual fresh-install verification) leaves these tarballs in the working
# tree; committing a build artifact of the very packages this repo publishes
# would ship a stale copy of itself.
*.tgz

# Never publish credentials or machine-local notes.
.env
.env.*
private/
.pi/
*.local.md
*.log
.DS_Store

# Isolated Rust verification builds and generated fuzz findings.
target/
crates/dshline-renderer/fuzz/artifacts/
crates/dshline-renderer/fuzz/corpus/
# Locally built optional native renderer artifacts; prebuild packaging owns distribution.
packages/renderer/native/*.node
