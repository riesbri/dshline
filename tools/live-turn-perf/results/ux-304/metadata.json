  "profileWorkspaceConfig": "packages:\n  - .\n\nnodeLinker: hoisted\nautoInstallPeers: false\n\n# pi-ai override \u2014 do not delete without reading this.\n#\n# `@deepseek-ai/dsh-llm-pi-ai` (inside `@deepseek-ai/dsh-base`) declares\n# `\"@earendil-works/pi-ai\": \"^0.87.1\"`. On a 0.x version a caret pins the MINOR\n# \u2014 `^0.87.1` means >=0.87.1 <0.88.0 \u2014 so the 0.99.1 line can never be selected\n# by an ordinary install, and `latest` only reaches 0.87.1. This is not a dshline\n# dependency: dshline does not depend on pi-ai at all.\n#\n# The upper bound is real, not cosmetic: on this machine only 0.99.1 carries the\n# `gpt-6.1-sol` ids (0.87.1 has none). Verified against pi-ai's own published\n# catalog, with the runtime confirming it through `ctx.llm.listModels()`.\n#\n# Upstream still pins `^0.87.1` on master, so adopting a newer Harness\n# generation does NOT deliver this model; widening the range belongs there.\n# This override is the local stand-in until then.\n#\n# Verified compatible: the pi-ai API surface the adapter imports is unchanged\n# between 0.87.1 and 0.99.1, and both compat interfaces\n# (OpenAIResponsesCompat, OpenAICompletionsCompat) have identical field sets,\n# so the adapter's compile-time drift gates stay satisfied at runtime.\noverrides:\n  '@earendil-works/pi-ai': 0.99.1\n\nminimumReleaseAgeExclude:\n  - '@dshline/dshline@0.8.0 || 0.17.0'\n  - '@dshline/renderer@0.8.0 || 0.17.0'\n  # Both are inside this machine's minimumReleaseAge quarantine. pnpm adds\n  # these automatically during the install that creates the override above;\n  # they are kept explicit because removing either reinstates the quarantine\n  # and silently reinstalls 0.87.1 \u2014 which looks like the override \"not\n  # working\" rather than like a removed exclusion.\n  - '@earendil-works/pi-ai@0.99.1'\n  - '@earendil-works/pi-telemetry@0.99.1'\n\nallowBuilds:\n  '@google/genai': set this to true or false\n  protobufjs: set this to true or false\n\n# `@deepseek-ai/dsh-llm-pi-ai` is declared directly in this profile so the pi-ai\n# override above has a resolution point for pnpm to bind. Its peers are not\n# duplicated here: they are satisfied by the shared/global dsh install that\n# `@deepseek-ai/dsh-base` loads the adapter from. These are therefore not missing\n# peers, and `pnpm peers check` is clean with them ignored.\npeerDependencyRules:\n  ignoreMissing:\n    - '@deepseek-ai/dsh-attachment'\n    - '@deepseek-ai/dsh-authorization'\n    - '@deepseek-ai/dsh-credentials'\n    - '@deepseek-ai/dsh-fs'\n    - '@deepseek-ai/dsh-launch-environment'\n    - '@deepseek-ai/dsh-llm'\n    - '@deepseek-ai/dsh-timeout'\n    - '@deepseek-ai/cordis'\n    - '@deepseek-ai/cordis-plugin-loader'\n"
}
